# CloudBase（腾讯云开发）。只填在本机 .env，不进仓库、不进聊天
TCB_ENV_ID=
TCB_SECRET_ID=
TCB_SECRET_KEY=
# 照片先审后显：1 开，0 关（开工周演示可先关，保留一键撤下）
KS_REVIEW=1
# 学号登记：验证码寄到 学号@buaa.edu.cn。用组里一个邮箱的 SMTP（QQ 邮箱：smtp.qq.com，465，密码填「授权码」）
# 没配这几项，线上就不开登记（页面上「盖章」那一块会写暂未开放）；本机开发不配也能试，验证码打在终端里
KS_SMTP_HOST=
KS_SMTP_PORT=465
KS_SMTP_USER=
KS_SMTP_PASS=
KS_MAIL_FROM=
# KS_AUTH_SECRET 第一次部署时自动生成写进 .env，不用填
